{
  "name": "echomind",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @echomind/desktop dev",
    "dev:web": "pnpm --filter @echomind/web dev",
    "tauri": "pnpm --filter @echomind/desktop tauri",
    "capture:build": "bash native/macos-capture/build.sh",
    "transcriber:build": "bash native/transcriber/build.sh",
    "minutes": "pnpm --filter @echomind/minutes-engine minutes",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "desktop:package": "bash apps/desktop/scripts/package.sh"
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
